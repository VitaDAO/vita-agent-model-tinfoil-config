diff --git a/sglang/srt/constrained/reasoner_grammar_backend.py b/sglang/srt/constrained/reasoner_grammar_backend.py
index bb9403b..595861a 100644
--- a/sglang/srt/constrained/reasoner_grammar_backend.py
+++ b/sglang/srt/constrained/reasoner_grammar_backend.py
@@ -148,6 +148,28 @@ class ReasonerGrammarObject(BaseGrammarObject):
             return self.grammar.is_terminated()
         return False

+    def requires_vocab_mask(self) -> bool:
+        """Whether the current reasoning phase needs a token mask."""
+        if self.finished:
+            return False
+        if self._is_thinking():
+            return self.enable_token_filter and (
+                not self._can_think_more() or bool(self.think_excluded_token_ids)
+            )
+        if self._is_generation():
+            return self.grammar is not None and not self.grammar.is_terminated()
+        return False
+
+    def may_require_vocab_mask(self) -> bool:
+        """Be conservative across a speculative tree's phase transition."""
+        if self._is_thinking():
+            return (
+                self.grammar is not None
+                or self.enable_token_filter
+                or self.max_think_tokens >= 0
+            )
+        return self.requires_vocab_mask()
+
     def rollback(self, k):
         if self.grammar is not None:
             steps_after = min(k, max(0, self.tokens_after_end))
