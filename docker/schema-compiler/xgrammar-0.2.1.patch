+    const auto state = states[i];
+    bool accept = state[0] >= spec.min_items;
+    for (size_t c = 0; c < spec.contains.size(); ++c)
+      accept = accept && state[c + 1] >= spec.contains[c].minimum;
+    accepting.push_back(accept);
+    edges.emplace_back();
+    if (spec.max_items != -1 && state[0] >= spec.max_items) continue;
+    for (size_t v = 0; v < values.size(); ++v) {
+      State next = state;
+      next[0] = spec.max_items == -1 ? std::min(state[0] + 1, std::max<int64_t>(spec.min_items, 1))
+                                     : state[0] + 1;
