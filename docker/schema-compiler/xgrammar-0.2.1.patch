+std::string JSONSchemaConverter::GenerateArrayContains(
+    const ArraySpec& spec, const std::string& rule_name
+) {
+  const auto graph = BuildContainsGraph(spec);
+  if (!graph) throw std::runtime_error("unsatisfiable contains constraints");
+  const auto& values = graph->values;
+  const auto& edges = graph->edges;
+  const auto& accepting = graph->accepting;
+  const auto& productive = graph->productive;
+  indent_manager_.StartIndent();
+  const auto start = indent_manager_.StartSeparator();
+  const auto middle = indent_manager_.MiddleSeparator();
+  const auto end = indent_manager_.EndSeparator();
+  const auto empty = indent_manager_.EmptySeparator();
+  indent_manager_.EndIndent();
+  std::vector<std::string> literals;
+  for (size_t v = 0; v < values.size(); ++v)
+    literals.push_back(CreateRule(
+        SchemaSpec::Make(ConstSpec{values[v]}), rule_name + "_contains_value_" + std::to_string(v)
+    ));
+  auto name = [&](size_t i) { return rule_name + "_contains_state_" + std::to_string(i); };
+  for (size_t i = 0; i < graph->first.size(); ++i) {
+    if (!productive[i]) continue;
+    std::string body = accepting[i] ? (graph->first[i] ? empty : end) + " \"]\"" : "";
+    for (const auto& edge : edges[i]) {
+      if (!productive[edge.next]) continue;
+      if (!body.empty()) body += " | ";
+      body +=
+          (graph->first[i] ? start : middle) + " " + literals[edge.value] + " " + name(edge.next);
+    }
+    ebnf_script_creator_.AddRule(name(i), body);
+  }
+  return "\"[\" " + name(0);
+}
