# Minimal SGLang image for the vita-agent-model enclave.
#
# Why: Tinfoil enclaves are diskless — the pulled image lives in a ramdisk
# carved from enclave RAM. The official lmsysorg/sglang images are ~18 GB
# compressed (~35 GB extracted) and force the 128 GiB memory tier next to
# the 28.8 GiB FP8 model package. This keeps only what serving needs:
# sglang[srt] (pulls its pinned torch cu129 + sgl-kernel + flashinfer-python)
# plus the cu129 flashinfer prebuilt kernel cache, so nothing is JIT-compiled
# or downloaded at runtime (runtime-fetched kernels would be unattested).
#
# gcc stays: the Gated-DeltaNet linear-attention kernels are Triton, and
# Triton JIT-compiles host stubs at first use.

FROM python:3.12-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    FLASHINFER_DISABLE_DOWNLOAD=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev libnuma1 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --extra-index-url https://download.pytorch.org/whl/cu129 \
        "sglang[srt]==0.5.16" \
    && pip install --extra-index-url https://flashinfer.ai/whl/cu129 \
        flashinfer-jit-cache

RUN find /usr/local/lib/python3.12 -name '__pycache__' -type d -prune -exec rm -rf {} + \
    && rm -rf /root/.cache

ENTRYPOINT ["python3"]
